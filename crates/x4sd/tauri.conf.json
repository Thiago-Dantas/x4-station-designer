{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X4 Station Designer",
  "version": "1.1.0",
  "identifier": "dev.x4sd.designer",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "X4 Station Designer",
